{
  "rewrites": [{"source": "/((?!icons/.*|sw.js|manifest.json).*)", "destination": "/index.html"}],
  "headers": [
    {"source": "/((?!icons/|manifest.json).*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "X-XSS-Protection", "value": "1; mode=block"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains"},
      {"key": "Permissions-Policy", "value": "camera=(self), payment=(self), microphone=(), geolocation=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()"},
      {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
    ]},
    {"source": "/icons/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}]},
    {"source": "/manifest.json", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]}
  ]
}
